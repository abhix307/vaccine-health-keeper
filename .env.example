# Copy to .env for local development. NEVER commit the real .env file.

# Choose: development | testing | production
FLASK_ENV=development

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: defaults to SQLite at instance/app.db when unset.
# For PostgreSQL (recommended when the host has no persistent disk):
# DATABASE_URL=postgresql://user:password@host:5432/vacctrack

# Set to true when served over HTTPS (production). Forces Secure cookies.
SESSION_COOKIE_SECURE=false

# Cookie SameSite mode: Lax (default, recommended) | Strict | None.
# Use "None" ONLY when the app is embedded in a cross-site iframe (e.g. a
# sandboxed live preview). "None" automatically forces Secure cookies and
# requires HTTPS. CSRF token protection stays active in all modes.
# SESSION_COOKIE_SAMESITE=Lax

# Pagination / reminder tuning
ITEMS_PER_PAGE=8
REMINDER_WINDOW_DAYS=60
